# Copy to `_common/.env` and fill secrets. Supabase keys stay cloud URLs in every mode.
#
# Local dev (pnpm / uv on the host): use localhost and 127.0.0.1 below.
# Docker Compose: `docker-compose.yml` overrides broker and service URLs per container
# (e.g. api gets KAFKA_BROKERS=kafka:29092, AI_AGENTS_BASE_URL=http://ai-agents:8080,
# web server-side gets BACKEND_URL=http://api:4000). Keep host-facing URLs on localhost
# so NEXT_PUBLIC_* / EXPO_PUBLIC_* still work in the browser or on a device.

# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres
# Prefer the Supabase Session pooler URI for migrations when direct db.* IPv6 is blocked.
SUPABASE_MIGRATE_DB_URL=postgresql://postgres.your-project-id:password@aws-0-region.pooler.supabase.com:5432/postgres

# Async journaling (Kafka consumer): Supabase table must exist — see root README.
SUPABASE_PATIENT_NOTES_TABLE=patient_notes

# ─── Web + mobile clients (host machine / browser / simulator) ─────────────────
# Always point at the API as reachable from the client — localhost with published ports.
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=${BACKEND_URL}

# ─── Backend API (NestJS) ──────────────────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_CORS_ORIGIN=http://localhost:3000,http://localhost:8100

# ─── Kafka (chat → AI agents) ──────────────────────────────────────────────────
# Host dev + Kafka in Docker: keep 127.0.0.1:9092 (compose publishes kafka :9092).
# Compose overrides to kafka:29092 inside api / ai-agents containers automatically.
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CHAT_TOPIC=serene.chat.requests
KAFKA_CONSUMER_GROUP=serene-ai-agents

# ─── AI agents (FastAPI / LangChain, `ai-agents/app/`) ─────────────────────────
AI_AGENTS_HOST=0.0.0.0
AI_AGENTS_PORT=8080
# Backend on the host calls the agents URL below; compose sets http://ai-agents:8080 for the api container.
AI_AGENTS_BASE_URL=http://127.0.0.1:8080
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
