# Copy to `_common/.env` and fill secrets. Supabase keys stay cloud URLs in every mode.
#
# Run Compose with the same file so YAML substitutions resolve:
#   make docker-run-all   → docker compose --env-file ./_common/.env

# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres
# Prefer the Supabase Session pooler URI for migrations when direct db.* IPv6 is blocked.
SUPABASE_MIGRATE_DB_URL=postgresql://postgres.your-project-id:password@aws-0-region.pooler.supabase.com:5432/postgres

# ─── Ports (host published ports; must match docker-compose port mappings) ─────
BACKEND_PORT=4000
WEB_PORT=3000
AI_AGENTS_PORT=8080
MOBILE_PORT=8100

# ─── Backend API (NestJS, host dev) ────────────────────────────────────────────
BACKEND_CORS_ORIGIN=http://localhost:${WEB_PORT},http://localhost:${MOBILE_PORT}

# ─── Web + mobile clients (browser / device reach API via localhost) ─────────────
WEB_PUBLIC_URL=http://localhost:${WEB_PORT}
BACKEND_URL=http://localhost:${BACKEND_PORT}
NEXT_PUBLIC_BACKEND_URL=${BACKEND_URL}
EXPO_PUBLIC_BACKEND_URL=${BACKEND_URL}

# ─── Docker Compose — runtime overrides for containers (internal DNS / prod-like)
NODE_ENV_COMPOSE=production
KAFKA_BROKERS_COMPOSE=kafka:29092
AI_AGENTS_BASE_URL_COMPOSE=http://ai-agents:8080
WEB_SERVER_BACKEND_URL_COMPOSE=http://api:4000

# ─── Docker Compose — apache/kafka broker container environment ─────────────────
DOCKER_KAFKA_PUBLISH_PORT=9092
DOCKER_KAFKA_NODE_ID=1
DOCKER_KAFKA_PROCESS_ROLES=broker,controller
DOCKER_KAFKA_LISTENERS=PLAINTEXT://:29092,CONTROLLER://:9093,PLAINTEXT_HOST://:9092
DOCKER_KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
DOCKER_KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
DOCKER_KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
DOCKER_KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
DOCKER_KAFKA_CONTROLLER_QUORUM_VOTERS=1@localhost:9093
DOCKER_KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
DOCKER_KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
DOCKER_KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
DOCKER_KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# ─── Kafka — host processes (`make start-all` uses broker on localhost:9092) ───
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CHAT_TOPIC=serene.chat.requests
KAFKA_CONSUMER_GROUP=serene-ai-agents

# ─── AI agents (FastAPI; host uses AI_AGENTS_BASE_URL below) ──────────────────
AI_AGENTS_HOST=0.0.0.0
AI_AGENTS_BASE_URL=http://127.0.0.1:${AI_AGENTS_PORT}
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
