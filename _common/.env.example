# ─── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Optional: only for `pnpm --dir backend/app run migrate:supabase` when direct db.*:5432 fails (IPv6 timeout, firewall).
# Use the Session pooler URI from Supabase Dashboard → Project Settings → Database → Connection string.
# SUPABASE_MIGRATE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── API ───────────────────────────────────────────────────────────────────────
BACKEND_PORT=4000
BACKEND_CORS_ORIGIN=http://localhost:3000,http://localhost:8100
BACKEND_URL=http://api:4000 # if you run without Docker, change this to http://localhost:4000

# ─── Web (Next.js) ─────────────────────────────────────────────────────────────
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
NEXT_PUBLIC_BACKEND_URL=${BACKEND_URL}

# ─── Kafka (chat → AI agents) ─────────────────────────────────────────────────
# Comma-separated brokers. Leave unset to disable Kafka publishing in the API.
#
# Local processes on the host (make backend, make ai-agents) with Kafka from Docker Compose:
#   docker compose up -d kafka
# Prefer 127.0.0.1:9092 over localhost if you see flaky IPv6 (::1) connections to the broker.
#   KAFKA_BROKERS=127.0.0.1:9092
#
# The `api` service in docker-compose overrides this to `kafka:29092` (internal listener; host uses :9092).
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_CHAT_TOPIC=serene.chat.requests
KAFKA_CONSUMER_GROUP=serene-ai-agents

# ─── AI agents (FastAPI / LangChain, project root `ai-agents/app/`) ────────────
AI_AGENTS_HOST=0.0.0.0
AI_AGENTS_PORT=8080
# NestJS proxies chat streams here. Omit to default to http://127.0.0.1:${AI_AGENTS_PORT} (local dev).
AI_AGENTS_BASE_URL=http://127.0.0.1:8080
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Async journaling (Kafka consumer): Supabase table must exist — see root README.
SUPABASE_PATIENT_NOTES_TABLE=patient_notes

# Pinecone index dimension must match the embedding model (text-embedding-3-small → 1536).
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
