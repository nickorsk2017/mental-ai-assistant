{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@common/shared/*": ["../*"]
    },
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "strict": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../../../_common/types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
