{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@common/types/*": [
        "./_common/types/*"
      ],
      "@common/shared/*": [
        "./_common/*"
      ],
      "@/*": [
        "./web/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    "**/dist/**",
    "**/.next/**"
  ]
}
