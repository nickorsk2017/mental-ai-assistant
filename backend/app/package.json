    "@supabase/supabase-js": "^2.45.0",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "eslint": "^9.26.0",
    "jest": "^30.2.0",
    "ts-node": "^10.9.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.3.0"
