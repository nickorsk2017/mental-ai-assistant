{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main",
    "dev": "ts-node --transpile-only src/main.ts",
